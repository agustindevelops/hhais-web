generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Form {
  id        Int        @id @default(autoincrement())
  name      String
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Question {
  id        Int      @id @default(autoincrement())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  formId    Int
  label     String
  options   Json?
  values    Json?
  type      String?
  answer    Json?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId, position])
}

model Client {
  id           String              @id @default(cuid())
  name         String
  email        String
  accessTokens ClientAccessToken[]
  business     Business?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ClientAccessToken {
  id        String    @id @default(cuid())
  token     String    @unique
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clientId])
}

model Business {
  id        String    @id @default(cuid())
  clientId  String    @unique
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  legalName String?
  domain    String?
  website   String?
  contacts  Contact[]
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Contact {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  role       String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}

model Project {
  id                      String        @id @default(cuid())
  businessId              String
  business                Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                    String        @default("")
  descriptionMarkdown     String        @default("")
  additionalNotesMarkdown String?
  fee                     Decimal?      @db.Decimal(12, 2)
  /// Ranked values: time, quality, budget
  priorities              String[]      @default([])
  paymentPlanId           String?
  paymentPlan             PaymentPlan?  @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  submittedAt             DateTime?
  features                Feature[]
  integrations            Integration[]
  attachments             Attachment[]
  contract                Contract?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([businessId])
  @@index([paymentPlanId])
}

model Contract {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  clientSignedAt      DateTime?
  clientSignerName    String?
  clientSignaturePath String?

  hhaisSignedAt      DateTime?
  hhaisSignerName    String?
  hhaisSignaturePath String?

  finalPdfPath String?
  lockedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentPlan {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  sortOrder   Int       @default(0)
  projects    Project[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([sortOrder])
}

model Feature {
  id                  String               @id @default(cuid())
  projectId           String
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  descriptionMarkdown String               @default("")
  sortOrder           Int                  @default(0)
  featureIntegrations FeatureIntegration[]
  attachments         Attachment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([projectId])
  @@index([projectId, sortOrder])
}

model Integration {
  id                  String               @id @default(cuid())
  projectId           String
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  descriptionMarkdown String               @default("")
  /// existing | needs_creation | unknown
  accountStatus       String               @default("unknown")
  accountEmail        String?
  featureIntegrations FeatureIntegration[]
  attachments         Attachment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([projectId])
}

model FeatureIntegration {
  featureId     String
  integrationId String
  feature       Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@id([featureId, integrationId])
  @@index([integrationId])
}

model Attachment {
  id                  String       @id @default(cuid())
  projectId           String
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  featureId           String?
  feature             Feature?     @relation(fields: [featureId], references: [id], onDelete: SetNull)
  integrationId       String?
  integration         Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  fileName            String
  storagePath         String
  contentType         String
  byteSize            Int?
  /// created | uploaded
  status              String
  signatureExpiration DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([projectId])
  @@index([featureId])
  @@index([integrationId])
  @@index([storagePath])
  @@index([status])
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
