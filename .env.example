# Copy to .env and fill in local values from apps/hhais/web/.env

BREVO_API_KEY=
# Prisma Postgres URLs often use sslmode=require; the app maps that to verify-full.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full"

# Cloudflare R2 (intake document uploads)
# S3_API_URL = address (endpoint + bucket), not a secret by itself.
# Keys from Cloudflare → R2 → Manage API Tokens → Object Read & Write.
S3_API_URL=https://<accountId>.r2.cloudflarestorage.com/<bucket>
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_ACCESS_KEY=
