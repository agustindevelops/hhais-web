# Local Docker Postgres (`yarn db:up` / `docker compose up -d`)
# Host tools (yarn dev, prisma studio, prisma migrate) use localhost.
# The web container (docker compose --profile app) overrides the hostname to `db`.
POSTGRES_USER=hhais
POSTGRES_PASSWORD=hhais
POSTGRES_DB=hhais
POSTGRES_PORT=5432
DATABASE_URL="postgresql://hhais:hhais@localhost:5432/hhais?schema=public"

BREVO_API_KEY=

# Cloudflare R2 (intake document uploads)
# S3_API_URL = address (endpoint + bucket), not a secret by itself.
# Keys from Cloudflare → R2 → Manage API Tokens → Object Read & Write.
S3_API_URL=https://<accountId>.r2.cloudflarestorage.com/<bucket>
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_ACCESS_KEY=
