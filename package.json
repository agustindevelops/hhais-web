{
  "name": "hhais-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "prisma generate && next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:vercel": "vercel env run -e production -- node scripts/migrate-deploy.mjs",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "docker:up": "docker compose --profile app up --build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@iconify/react": "^5.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "aos": "^2.3.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.23.12",
    "glightbox": "^3.3.0",
    "marked": "^18.0.13",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.21.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-calendly": "^4.4.0",
    "react-dom": "^19.2.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-text-typist": "^1.1.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.4",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/aos": "^3.0.7",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-signature-canvas": "^1.0.7",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.6",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.3",
    "typescript": "^5.9.2"
  }
}
